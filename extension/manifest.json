
{
  "manifest_version": 3,
  "name": "Contextual AI Chat",
  "version": "0.1.0",
  "description": "Ask questions about selected text on ChatGPT.",
  "permissions": [],
  "host_permissions": [
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
